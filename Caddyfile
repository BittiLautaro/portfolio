# Configuración de Caddy para Railway.
{
	# Railway ya pone HTTPS y el certificado delante: Caddy solo atiende HTTP.
	auto_https off
	admin off
}

# Railway indica el puerto en la variable PORT; 8080 es el respaldo local.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	# Caché del navegador
	# - Fuentes: no cambian nunca → un año.
	# - Todo lo demás (HTML, CSS, JS e imágenes) se revalida en cada visita:
	#   si no cambió, Caddy responde 304 sin reenviarlo. Las capturas se
	#   reemplazan con el mismo nombre de archivo, y con un max-age el navegador
	#   seguiría mostrando la vieja sin preguntar.
	@fuentes path /assets/fonts/*
	header @fuentes Cache-Control "public, max-age=31536000, immutable"

	@resto not path /assets/fonts/*
	header @resto Cache-Control "no-cache"

	# Encabezados de seguridad básicos
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
